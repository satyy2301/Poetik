SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here
# Server scripts only (ingest, seed) — never commit or ship in the app
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_here
# Required for npm run db:push (direct connection — more reliable than access token)
SUPABASE_DB_PASSWORD=your_database_password_here

# Optional — only needed for supabase link / management API (not db:push)
SUPABASE_ACCESS_TOKEN=your_access_token_here

# Optional — only needed when AI features are re-enabled (Sprint 3+)
HF_TOKEN=your_hugging_face_token_here
PERPLEXITY_KEY=your_perplexity_api_key_here

# Optional — production monitoring (Sprint 7+)
SENTRY_DSN=your_sentry_dsn_here
POSTHOG_KEY=your_posthog_project_key_here
